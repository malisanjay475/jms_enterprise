# ============================================================
# JMS Enterprise — LOCAL Factory Server .env Template
# ============================================================
# Copy this file to BACKEND/.env on each LOCAL factory server.
# Fill in the values marked with  ← REQUIRED
#
#   cp .env.local-factory.example .env
#   nano .env
# ============================================================

NODE_ENV=production
PORT=3000

# ── Database (local PostgreSQL inside Docker) ───────────────
DB_HOST=db               # Docker-compose service name
DB_PORT=5432
DB_USER=jms_v1
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD    # ← REQUIRED
DB_NAME=jms_v1

# ── Server identity ─────────────────────────────────────────
# CRITICAL: Must be LOCAL (not MAIN, not STANDALONE) so sync runs.
SERVER_TYPE=LOCAL

# URL of the MAIN server (Hostinger VPS). Include http/https and port if needed.
MAIN_SERVER_URL=https://your-vps-domain.com   # ← REQUIRED

# Which factory this server represents. Get this ID from the MAIN server's
# factories table (or ask the admin). Must be a positive integer.
LOCAL_FACTORY_ID=1                            # ← REQUIRED — set correct factory id

# Shared secret for sync authentication.
# Must match the SYNC_API_KEY set in the MAIN server's .env.
# Use a long random string: openssl rand -hex 32
SYNC_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY  # ← REQUIRED — same on LOCAL + MAIN

# ── JWT / Session ───────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET   # ← REQUIRED

# ── Sync timing (safe defaults — do not change unless advised) ─
SYNC_INTERVAL_MS=300000          # Sync every 5 minutes
SYNC_INITIAL_DELAY_MS=30000      # First sync 30s after startup
SYNC_TRIGGER_DEBOUNCE_MS=5000
SYNC_PENDING_COUNT_INTERVAL_MS=300000
SYNC_FORCE_SCHEMA_ENSURE=0       # Set to 1 only after schema changes

# ── LOCAL Node Agent (heartbeat to MAIN) ────────────────────
LOCAL_SERVER_AGENT_ENABLED=1
LOCAL_SERVER_NODE_ID=factory-01              # Unique name for this server
LOCAL_SERVER_NODE_KEY=REPLACE_WITH_NODE_KEY  # ← REQUIRED — set in MAIN's local_servers table
LOCAL_SERVER_PUBLIC_IP=                      # Optional: your static IP
LOCAL_SERVER_HEARTBEAT_INTERVAL_MS=60000

# ── Optional ────────────────────────────────────────────────
GEMINI_API_KEY=
APP_GIT_SHA=local
