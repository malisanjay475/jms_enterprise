# Same variables as env.docker.example — used by VPS / Hostinger v1 stacks.
# Hostinger uses image ghcr.io/malisanjay475/jms-v1-app:latest (see GitHub Actions).
DB_USER=jms_v1
DB_PASSWORD=replace_with_long_random_password
DB_NAME=jms_v1
V1_HTTP_PORT=9091
GEMINI_API_KEY=
APP_GIT_SHA=
SERVER_TYPE=MAIN
MAIN_SERVER_URL=
LOCAL_FACTORY_ID=
SYNC_API_KEY=
LOCAL_SERVER_AGENT_ENABLED=
LOCAL_SERVER_NODE_ID=
LOCAL_SERVER_NODE_KEY=
LOCAL_SERVER_PUBLIC_IP=
LOCAL_SERVER_HEARTBEAT_INTERVAL_MS=

# Web pgAdmin (https://pgadmin.jmsocean.cloud) — see docker-compose.vps-v1-isolated.yml.
# Requires DNS A record pgadmin.jmsocean.cloud -> VPS for the LetsEncrypt cert.
PGADMIN_DEFAULT_EMAIL=admin@jmsocean.cloud
PGADMIN_DEFAULT_PASSWORD=replace_with_strong_password

# JMS Chat Web Push (closed-tab notifications), MAIN only. Generate once:
#   npx web-push generate-vapid-keys
# Keep the private key secret (never commit it). Leave empty to switch push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jmsocean.cloud

# JMS Chat Android app push (Firebase Cloud Messaging), MAIN only. Firebase console >
# Project settings > Service accounts > Generate new private key, then paste the JSON
# base64-encoded on ONE line (base64 -w0 key.json). Secret: never commit it. Empty = off.
FCM_SERVICE_ACCOUNT=

# JMS Chat emergency switch / staged rollout. Leave empty to use Settings > Chat.
# CHAT_ENABLED=0 hides chat for everyone; CHAT_FACTORIES=1 (or 1,3) enables it for those factories only.
CHAT_ENABLED=
CHAT_FACTORIES=
