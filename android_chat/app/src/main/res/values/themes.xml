<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JmsChat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/chat_green</item>
        <item name="android:windowBackground">@color/chat_bg</item>
    </style>

    <!-- Splash while the app starts: JMS logo on JMS Chat green, then the normal theme. -->
    <style name="Theme.JmsChat.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/chat_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.JmsChat</item>
    </style>
</resources>
