<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme. Compose paints the real UI; this only styles the
         window before Compose takes over (splash background + status bar). -->
    <style name="Theme.QcOcean" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bone</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
